@@ -108,6 +108,31 @@ public class LevelChunkTicks<T> implements TickContainerAccess<T>, SerializableT
         return this.tickQueue.stream();
     }
 
+    // Paper Lab - postpone ticks in frozen zones
+    public boolean postponeTicks(final Predicate<BlockPos> shouldPostpone, final long delta) {
+        if (this.tickQueue.isEmpty() || delta <= 0L) {
+            return false;
+        }
+        List<ScheduledTick<T>> postponed = null;
+        Iterator<ScheduledTick<T>> iterator = this.tickQueue.iterator();
+        while (iterator.hasNext()) {
+            ScheduledTick<T> tick = iterator.next();
+            if (shouldPostpone.test(tick.pos())) {
+                iterator.remove();
+                if (postponed == null) {
+                    postponed = new ArrayList<>();
+                }
+                postponed.add(new ScheduledTick<>(tick.type(), tick.pos(), tick.triggerTick() + delta, tick.priority(), tick.subTickOrder()));
+            }
+        }
+        if (postponed != null) {
+            this.tickQueue.addAll(postponed);
+            this.dirty = true;
+            return true;
+        }
+        return false;
+    }
+
     @Override
     public int count() {
         return this.tickQueue.size() + (this.pendingTicks != null ? this.pendingTicks.size() : 0);
