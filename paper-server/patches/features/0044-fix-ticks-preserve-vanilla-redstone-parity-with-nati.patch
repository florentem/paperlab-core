+    // Paper Lab - postpone ticks in skipping/frozen zones
+    public void postponeSkippingTicks(final net.minecraft.world.level.Level level) {
+        if (!io.papermc.paper.lab.zone.LabTickZones.hasSkippingZones(level)) {
+            return;
+        }
+        final it.unimi.dsi.fastutil.longs.LongSet skippingChunks = io.papermc.paper.lab.zone.LabTickZones.getSkippingChunkPositions(level);
+        if (skippingChunks.isEmpty()) {
+            return;
+        }
+        final it.unimi.dsi.fastutil.longs.LongIterator it = skippingChunks.iterator();
+        while (it.hasNext()) {
+            final long chunkPos = it.nextLong();
+            final LevelChunkTicks<T> container = this.allContainers.get(chunkPos);
+            if (container != null && container.count() > 0) {
+                final boolean changed = container.postponeTicks(pos -> io.papermc.paper.lab.zone.LabTickZones.isBlockFrozen(level, pos), 1L);
+                if (changed) {
+                    final ScheduledTick<T> top = container.peek();
+                    if (top != null) {
+                        this.nextTickForContainer.put(chunkPos, top.triggerTick());
+                    } else {
+                        this.nextTickForContainer.remove(chunkPos);
+                    }
+                }
+            }
+        }
+    }
+
