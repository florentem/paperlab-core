         this.setPos(x, y, z);
         this.setItem(itemStack);
         this.setDeltaMovement(deltaX, deltaY, deltaZ);
+        io.papermc.paper.lab.item.LabItemTracker.onItemCreated(this); // Paper Lab - /log item
     }
 
     // Paper start - Require item entities to send their location precisely (Fixes MC-4)
@@ -230,6 +231,7 @@ public class ItemEntity extends Entity implements TraceableEntity {
                     return;
                 }
                 // CraftBukkit end
+                io.papermc.paper.lab.item.LabItemTracker.onItemDespawned(this); // Paper Lab - /log item
                 this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN); // CraftBukkit - add Bukkit remove cause
             }
         }
@@ -363,6 +365,7 @@ public class ItemEntity extends Entity implements TraceableEntity {
         this.gameEvent(GameEvent.ENTITY_DAMAGE, source.getEntity());
         if (this.health <= 0) {
             this.getItem().onDestroyed(this);
+            io.papermc.paper.lab.item.LabItemTracker.onItemDied(this, source, damage); // Paper Lab - /log item
             this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DEATH); // CraftBukkit - add Bukkit remove cause
         }
 
