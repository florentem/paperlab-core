+    // Paper Lab - tick zones execution
+    public void runZoneTicks(final io.papermc.paper.lab.zone.LabTickZone zone, final long maxTick) {
+        this.blockTicks.drainAndRunZoneTicks(zone, maxTick, this::tickBlock);
+        this.fluidTicks.drainAndRunZoneTicks(zone, maxTick, this::tickFluid);
+    }
+
+    public void runZoneBlockEvents(final io.papermc.paper.lab.zone.LabTickZone zone) {
+        if (this.blockEvents.isEmpty()) {
+            return;
+        }
+        final List<BlockEventData> zoneEvents = new ArrayList<>();
+        final List<BlockEventData> remainingEvents = new ArrayList<>();
+        while (!this.blockEvents.isEmpty()) {
+            final BlockEventData event = this.blockEvents.removeFirst();
+            if (zone.contains(event.pos())) {
+                zoneEvents.add(event);
+            } else {
+                remainingEvents.add(event);
+            }
+        }
+        this.blockEvents.addAll(remainingEvents);
+        for (final BlockEventData eventData : zoneEvents) {
+            if (this.shouldTickBlocksAt(eventData.pos())) {
+                if (this.doBlockEvent(eventData)) {
+                    this.server
+                        .getPlayerList()
+                        .broadcast(
+                            null,
+                            eventData.pos().getX(),
+                            eventData.pos().getY(),
+                            eventData.pos().getZ(),
+                            64.0,
+                            this.dimension(),
+                            new ClientboundBlockEventPacket(eventData.pos(), eventData.block(), eventData.paramA(), eventData.paramB())
+                        );
+                }
+            } else {
+                this.blockEvents.add(eventData);
+            }
+        }
+    }
+
+    public void runZoneEntities(final io.papermc.paper.lab.zone.LabTickZone zone) {
+        this.entityTickList.forEach(entity -> {
+            if (!entity.isRemoved() && !(entity instanceof net.minecraft.world.entity.player.Player)) {
+                if (zone.contains(entity.blockPosition()) || zone.intersects(entity.getBoundingBox())) {
+                    final Entity vehicle = entity.getVehicle();
+                    if (vehicle != null) {
+                        if (!vehicle.isRemoved() && vehicle.hasPassenger(entity)) {
+                            return;
+                        }
+                        entity.stopRiding();
+                    }
+                    this.guardEntityTick(this::tickNonPassenger, entity);
+                }
+            }
+        });
+    }
+
+    public void runZoneBlockEntities(final io.papermc.paper.lab.zone.LabTickZone zone) {
+        this.tickZoneBlockEntities(zone::contains);
+    }
+
+    public void setHandlingTick(final boolean handlingTick) {
+        this.handlingTick = handlingTick;
+    }
+
+    @Override
+    public long getGameTime() {
+        final io.papermc.paper.lab.zone.LabTickZone current = io.papermc.paper.lab.zone.LabTickZones.getCurrentTickingZone();
+        if (current != null) {
+            return current.getGameTime(this);
+        }
+        return this.levelData.getGameTime();
+    }
+
+    @Override
+    public <T> net.minecraft.world.ticks.ScheduledTick<T> createTick(final BlockPos pos, final T type, final int tickDelay, final net.minecraft.world.ticks.TickPriority priority) {
+        long baseTime = io.papermc.paper.lab.zone.LabTickZones.getGameTimeFor(this, pos);
+        return new net.minecraft.world.ticks.ScheduledTick<>(type, pos, baseTime + tickDelay, priority, this.nextSubTickCount());
+    }
+
+    @Override
+    public <T> net.minecraft.world.ticks.ScheduledTick<T> createTick(final BlockPos pos, final T type, final int tickDelay) {
+        long baseTime = io.papermc.paper.lab.zone.LabTickZones.getGameTimeFor(this, pos);
+        return new net.minecraft.world.ticks.ScheduledTick<>(type, pos, baseTime + tickDelay, this.nextSubTickCount());
     }
 
