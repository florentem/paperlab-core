+    public void shiftZoneTicks(final io.papermc.paper.lab.zone.LabTickZone zone, final long delta) {
+        for (final long chunkPos : zone.chunkPositions()) {
+            final LevelChunkTicks<T> container = this.allContainers.get(chunkPos);
+            if (container != null) {
+                final boolean changed = container.postponeTicks(zone::contains, delta);
+                if (changed) {
+                    final ScheduledTick<T> next = container.peek();
+                    if (next == null) {
+                        this.nextTickForContainer.remove(chunkPos);
+                    } else {
