+    // Paper Lab - tick accelerated zone block entities
+    public void tickZoneBlockEntities(final java.util.function.Predicate<BlockPos> inZone) {
+        this.tickingBlockEntities = true;
+        try {
+            if (!this.pendingBlockEntityTickers.isEmpty()) {
+                this.blockEntityTickers.addAll(this.pendingBlockEntityTickers);
+                this.pendingBlockEntityTickers.clear();
+            }
+            final int initialSize = this.blockEntityTickers.size();
+            for (int bi = 0; bi < initialSize; bi++) {
+                final TickingBlockEntity ticker = this.blockEntityTickers.get(bi);
+                if (!ticker.isRemoved() && inZone.test(ticker.getPos())) {
+                    ticker.tick();
+                }
+            }
+        } finally {
+            this.tickingBlockEntities = false;
+        }
+    }
