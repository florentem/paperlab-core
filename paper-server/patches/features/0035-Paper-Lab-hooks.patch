@@ -807,6 +807,15 @@ public final class RegionizedPlayerChunkLoader {
             // take the allocations we actually used
             this.chunkGenerateTicketLimiter.returnUnused(maxGensThisTick - ratedGensThisTick);
 
+            // Paper Lab - наблюдатель не делает ticking ни одного чанка.
+            // Персональной дистанции симуляции 0 недостаточно: tickMap с радиусом 0
+            // покрывает чанк под самим игроком, и энтити в нём оживают, стоит туда войти.
+            // Гасим очередь здесь: это единственная точка, где чанк переходит в TICK,
+            // а при выключении режима update() ставит чанки обратно в очередь сам.
+            if (io.papermc.paper.lab.ghost.LabGhost.isGhost(this.player)) {
+                this.tickingQueue.clear();
+            }
+            // Paper Lab end
             // try to pull ticking chunks
             while (!this.tickingQueue.isEmpty()) {
                 final long pendingTicking = this.tickingQueue.firstLong();
