             // take the allocations we actually used
             this.chunkGenerateTicketLimiter.returnUnused(maxGensThisTick - ratedGensThisTick);
 
+            // Paper Lab - the observer makes no chunk tick.
+            // A personal simulation distance of 0 is not enough: tickMap at radius 0 still
+            // covers the chunk under the player, and entities there wake up on entry.
+            // We clear the queue here: it is the only point where a chunk enters TICK, and
+            // when the mode is turned off update() re-queues the chunks by itself.
+            if (io.papermc.paper.lab.ghost.LabGhost.isGhost(this.player)) {
+                this.tickingQueue.clear();
+            }
+            // Paper Lab end
             // try to pull ticking chunks
             while (!this.tickingQueue.isEmpty()) {
                 final long pendingTicking = this.tickingQueue.firstLong();
