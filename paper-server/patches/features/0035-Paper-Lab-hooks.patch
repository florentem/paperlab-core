+++ b/net/minecraft/util/debug/ServerDebugSubscribers.java
@@ -50,6 +50,13 @@ public class ServerDebugSubscribers {
     }
 
     public boolean hasRequiredPermissions(final ServerPlayer player) {
+        // Paper Lab - debug subscriptions by permission, not by operator status alone.
+        // MiniHUD draws what these subscriptions carry (mob paths, neighbour updates,
+        // redstone order, POI), and handing out full OP for that is too large a coin.
+        if (player.getBukkitEntity().hasPermission("paperlab.debugdata")) {
+            return true;
+        }
+        // Paper Lab end
         NameAndId nameAndId = player.nameAndId();
         return SharedConstants.IS_RUNNING_IN_IDE && this.server.isSingleplayerOwner(nameAndId) || this.server.getPlayerList().isOp(nameAndId);
     }
