                     final long ticksBehind = Math.max(1L, this.tickSchedule.getPeriodsAhead(thisTickNanos, tickStart));
@@ -1369,6 +1387,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                     this.finishMeasuringTaskExecutionTime();
                     if (sprinting) {
                         this.tickRateManager.endTickWork();
+                        if (io.papermc.paper.lab.tick.LabPerWorldTick.isEnabled()) {
+                            for (ServerLevel level : this.getAllLevels()) {
+                                if (level != null && level.perWorldTickRateManager() != null && level.perWorldTickRateManager().isSprinting()) {
+                                    level.perWorldTickRateManager().endTickWork();
