@@ -1736,6 +1761,21 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         if (newAutosaveInterval < this.ticksUntilAutosave) {
             this.ticksUntilAutosave = newAutosaveInterval;
         }
+        if (this.tickSchedule != null) {
+            long interval = this.tickRateManager.nanosecondsPerTick();
+            if (io.papermc.paper.lab.tick.LabPerWorldTick.isEnabled()) {
+                for (ServerLevel level : this.getAllLevels()) {
+                    if (level != null && level.perWorldTickRateManager() != null) {
+                        if (level.perWorldTickRateManager().isSprinting()) {
+                            interval = 0L;
+                            break;
+                        }
+                        interval = Math.min(interval, level.perWorldTickRateManager().nanosecondsPerTick());
+                    }
+                }
+            }
+            this.tickSchedule.setNextPeriod(this.nextTickTimeNanos, interval);
+        }
     }
 
