     }
 
+    // Paper Lab - tick acceleration in zones
+    public void drainAndRunZoneTicks(final io.papermc.paper.lab.zone.LabTickZone zone, final long maxTick, final BiConsumer<BlockPos, T> output) {
+        for (long chunkPos : zone.chunkPositions()) {
+            LevelChunkTicks<T> container = this.allContainers.get(chunkPos);
+            if (container == null) {
+                continue;
+            }
+            List<ScheduledTick<T>> toRun = null;
+            for (ScheduledTick<T> tick : container.getAll().toList()) {
+                if (tick.triggerTick() <= maxTick && zone.contains(tick.pos())) {
+                    if (toRun == null) {
+                        toRun = new ArrayList<>();
+                    }
+                    toRun.add(tick);
+                }
+            }
+            if (toRun != null) {
+                container.removeIf(toRun::contains);
+                for (ScheduledTick<T> tick : toRun) {
+                    output.accept(tick.pos(), tick.type());
+                }
+            }
+        }
+    }
+
     @FunctionalInterface
     private interface PosAndContainerConsumer<T> {
         void accept(long pos, LevelChunkTicks<T> container);
