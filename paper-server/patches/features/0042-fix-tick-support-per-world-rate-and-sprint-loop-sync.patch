+    // Paper Lab start - entity freeze sync
+    private boolean labFrozen = false;
+    private boolean labSavedNoGravity = false;
+    private boolean labSavedNoAi = false;
+    private net.minecraft.world.phys.Vec3 labSavedDeltaMovement = null;
+
+    public boolean isLabFrozen() {
+        return this.labFrozen;
+    }
+
+    public boolean getLabSavedNoGravity() {
+        return this.labSavedNoGravity;
+    }
+
+    public boolean getLabSavedNoAi() {
+        return this.labSavedNoAi;
+    }
+
+    public void setLabFrozen(final boolean frozen) {
+        if (this.labFrozen == frozen) {
+            return;
+        }
+        if (this instanceof net.minecraft.world.entity.player.Player) {
+            return;
+        }
+        this.labFrozen = frozen;
+        if (frozen) {
+            this.labSavedNoGravity = this.isNoGravity();
+            this.labSavedDeltaMovement = this.getDeltaMovement();
+            if (this instanceof Mob mob) {
+                this.labSavedNoAi = mob.isNoAi();
+                mob.setNoAi(true);
+            }
+            this.setNoGravity(true);
+            this.setDeltaMovement(net.minecraft.world.phys.Vec3.ZERO);
+            if (this.level() instanceof net.minecraft.server.level.ServerLevel sl) {
+                sl.getChunkSource().sendToTrackingPlayers(this, new net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket(this.getId(), net.minecraft.world.phys.Vec3.ZERO));
+                sl.getChunkSource().sendToTrackingPlayers(this, net.minecraft.network.protocol.game.ClientboundEntityPositionSyncPacket.of(this));
+            }
+        } else {
+            this.setNoGravity(this.labSavedNoGravity);
+            if (this instanceof Mob mob) {
+                mob.setNoAi(this.labSavedNoAi);
+            }
+            if (this.labSavedDeltaMovement != null) {
+                this.setDeltaMovement(this.labSavedDeltaMovement);
+                if (this.level() instanceof net.minecraft.server.level.ServerLevel sl) {
+                    sl.getChunkSource().sendToTrackingPlayers(this, new net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket(this.getId(), this.labSavedDeltaMovement));
+                }
+                this.labSavedDeltaMovement = null;
+            }
+            if (this.level() instanceof net.minecraft.server.level.ServerLevel sl) {
+                sl.getChunkSource().sendToTrackingPlayers(this, net.minecraft.network.protocol.game.ClientboundEntityPositionSyncPacket.of(this));
+            }
+        }
+    }
+    // Paper Lab end - entity freeze sync
+
